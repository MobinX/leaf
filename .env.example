# Firebase (Google login) — get these from the Firebase console -> Project settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Optional: same-origin Yjs endpoint override (defaults to /collab/rooms).
# NEXT_PUBLIC_YJS_SERVER=

# Cloudflare Worker (optional hardening):
# FIREBASE_PROJECT_ID=  # lock invite API to one Firebase project
# REQUIRE_AUTH=1        # disable the x-dev-user-email fallback
